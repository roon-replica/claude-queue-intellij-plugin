<idea-plugin>
    <depends>com.intellij.modules.platform</depends>
    <!-- 터미널 실행 모드 — IDEA 번들 플러그인 -->
    <depends>org.jetbrains.plugins.terminal</depends>

    <!-- 마켓플레이스에 그대로 노출되는 설명 — HTML 만 허용된다 -->
    <description><![CDATA[
        Queue up Claude Code tasks and run them one after another in your IDE terminal.
        <ul>
          <li><b>TODO / In progress / Done</b> board — drag cards to reorder or to start them.</li>
          <li>Tasks run in a <b>real Claude Code terminal</b>, so you can watch and step in at any time.</li>
          <li>Pick which terminal a task runs in — a new tab, one the plugin opened, or a shell you opened yourself.</li>
          <li>Completion is detected automatically and the next task starts on its own.</li>
        </ul>
        Requires the <code>claude</code> CLI on your PATH.
    ]]></description>

    <extensions defaultExtensionNs="com.intellij">
        <!--
          NONE = IDE 풍선을 띄우지 않는다. 알림은 OS(맥 알림 센터)로 보내고
          여기서는 Event Log 에 기록만 남긴다 — 화면 위로 튀어나오는 풍선은 거슬린다.
          유저가 원하면 설정 → Notifications 에서 풍선을 다시 켤 수 있다.
        -->
        <notificationGroup id="Task Queue" displayType="NONE"/>
        <toolWindow id="Task Queue"
                    anchor="bottom"
                    icon="dev.roon.taskqueue.ui.TaskQueueIcons.ToolWindow"
                    factoryClass="dev.roon.taskqueue.ui.TaskQueueToolWindowFactory"/>
        <applicationService serviceImplementation="dev.roon.taskqueue.cli.ClaudeCli"/>
        <applicationService serviceImplementation="dev.roon.taskqueue.session.SessionWatcher"/>
        <applicationService serviceImplementation="dev.roon.taskqueue.hook.StopHookWatcher"/>
        <applicationService serviceImplementation="dev.roon.taskqueue.terminal.TerminalSessionRegistry"/>
        <applicationService serviceImplementation="dev.roon.taskqueue.queue.TaskQueueService"/>
    </extensions>

    <actions>
        <action id="TaskQueue.EnqueueSelection"
                class="dev.roon.taskqueue.actions.EnqueueSelectionAction"
                text="Add to Task Queue"
                description="Queue the selection or file as an automated task">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="control alt shift Q"/>
        </action>
    </actions>
</idea-plugin>
